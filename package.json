{
  "name": "mais-migration",
  "version": "0.1.0",
  "description": "Migrador de ERPs — aplicação desktop para suporte N1",
  "author": "MAIS",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "drizzle-orm": "^0.39.1",
    "node-firebird": "^2.14.3",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "sql.js": "^1.12.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.4",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.mais.migration",
    "productName": "MAIS Migration",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!config/destino.ini"
    ],
    "asarUnpack": [
      "**/*.wasm",
      "**/sql.js/**"
    ],
    "extraFiles": [
      {
        "from": "config/destino.ini.example",
        "to": "config/destino.ini.example"
      }
    ],
    "extraResources": [
      {
        "from": "config/destino.ini.example",
        "to": "config/destino.ini.example"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MAIS Migration",
      "unicode": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerLanguages": [
        "pt_BR"
      ]
    }
  }
}